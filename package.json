{
	"name": "@stelliajs/framework",
	"version": "1.9.1",
	"type": "module",
	"description": "A framework for simplifying the creation of discord bots",
	"author": "Tweenty_",
	"license": "ISC",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"keywords": [
		"discord",
		"bot",
		"discordjs",
		"typescript",
		"framework"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/StelliaJS/framework.git"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint src",
		"format": "prettier --write ./src/**/*.ts"
	},
	"peerDependencies": {
		"discord.js": "^14.27.0",
		"i18next": "26.3.6"
	},
	"dependencies": {
		"log-symbols": "^7.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"discord.js": "^14.27.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.9.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.6",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0"
	}
}